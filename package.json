{
  "name": "FirstWord",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first Singapore child safety case intake and recommendation support desktop app.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:api": "python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8766 --reload",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "wait-on http://127.0.0.1:5173 http://127.0.0.1:8766/health && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "package:win": "npm run build && electron-builder --win nsis",
    "lint": "eslint frontend/src --ext .ts,.tsx"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "electron-builder": "^25.1.8",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "sg.gov.local.child-safety-intake",
    "productName": "FirstWord",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "requirements.txt",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": "nsis"
    }
  }
}
